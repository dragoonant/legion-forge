                      "trooper-any"
                    ],
                    "notRanks": [
                      "commander",
                      "operative"
                    ]
                  },
                  "then": [
                    {
                      "sufferWounds": {
                        "n": 1,
                        "who": "chosen"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ],
    "restrictions": {
      "forceAffinity": "dark"
    },
    "source": {
      "doc": "GUP",
      "page": 19,
      "kind": "primary",
      "checked": "by-eye 2026-10-29"
    },
    "text": "Exhaust for a free card action: an enemy Trooper unit within range 1 that is neither a Commander nor an Operative suffers 1 wound."
