{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion-forge.dev/schemas/keyword.schema.json",
  "$defs": {
    "keyword": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/Name"
        },
        "kind": {
          "enum": [
            "unit",
            "weapon",
            "card"
          ]
        },
        "param": {
          "enum": [
            "none",
            "x",
            "rank",
            "unitType",
            "unit"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Effect"
          },
          "minItems": 1
        },
        "text": {
          "$ref": "common.schema.json#/$defs/Text"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/Sources"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "param",
        "effects",
        "text",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
