            "white": {
              "type": "object",
              "properties": {
                "sides": {
                  "type": "integer",
                  "minimum": 2
                },
                "faces": {
                  "type": "object",
                  "properties": {
                    "hit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "crit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "surge": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "blank": {
                      "type": "integer",
                      "minimum": 0
                    }
