    "constants": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/Sources"
          }
        }
      },
      "required": [
        "id",
        "values",
