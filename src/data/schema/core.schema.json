            "white": {
              "type": "object",
              "properties": {
                "sides": {
                  "type": "integer",
                  "minimum": 2
                },
                "faces": {
                  "type": "object",
                  "properties": {
                    "block": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "surge": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "blank": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "block",
                    "surge",
                    "blank"
